<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- S9.3: every assertion in S1-S8 lives in this project, and Testing's own package dependencies
       (S9.5's nuspec graph) already carry Hosting, Persistence, Observability, Core and
       Abstractions transitively, so switching this one reference is enough to rerun the whole
       suite against the packages release.yml just published, rather than the source tree. See
       samples/SubZeroDev.Platform.Sample.Web.csproj for the same UsePlatformPackages switch. -->
  <ItemGroup Condition="'$(UsePlatformPackages)' != 'true'">
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Testing\SubZeroDev.Platform.Testing.csproj" />
  </ItemGroup>

  <!-- Identity is not packed yet (S18 packs every D5 package), so there is no package form for
       UsePlatformPackages to switch this to: a project reference regardless. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Identity\SubZeroDev.Platform.Identity.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Organizations\SubZeroDev.Platform.Organizations.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Billing\SubZeroDev.Platform.Billing.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Licensing\SubZeroDev.Platform.Licensing.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Audit\SubZeroDev.Platform.Audit.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Mcp\SubZeroDev.Platform.Mcp.csproj" />
  </ItemGroup>

  <!-- D5-S16: the shell's endpoints and permission declarations live in the sample host that backs
       it, so the shell's-call-list assertion (I-W1) and the switch-endpoint HTTP test (S16.2) drive
       the exact same mapping the shell calls rather than a reimplementation of it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\samples\SubZeroDev.Platform.Sample.Web\SubZeroDev.Platform.Sample.Web.csproj" />
  </ItemGroup>

  <!-- Sample.Web is a Microsoft.NET.Sdk.Web project, and referencing it copies its own
       appsettings.json (CopyToOutputDirectory content) into this project's output directory too —
       ExcludeAssets does not stop this, because Sample.Web is not packable and NuGet never builds
       an asset group for it to exclude from. Left in place, that file sits beside this assembly and
       ASP.NET Core's default configuration loading picks it up in every test that builds a
       WebApplication, silently overriding Settings.Required()'s :memory: connection string with
       Sample.Web's own "Data Source=sample.db" — a single real file every parallel test class would
       then contend for. Deleting it after build is the fix; the file has no purpose here and
       Sample.Web's own build is unaffected. -->
  <Target Name="RemoveLeakedSampleWebContent" AfterTargets="Build;Publish">
    <ItemGroup>
      <_LeakedSampleWebContent Include="$(OutDir)appsettings.json" />
    </ItemGroup>
    <Delete Files="@(_LeakedSampleWebContent)" Condition="Exists('$(OutDir)appsettings.json')" />
  </Target>

  <ItemGroup Condition="'$(UsePlatformPackages)' == 'true'">
    <PackageReference Include="SubZeroDev.Platform.Testing" Version="$(PlatformPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
