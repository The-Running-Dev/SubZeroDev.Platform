<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- D5-S23: built the way a vendor configuration package would be. It is a configuration source, so
       it depends on the host's configuration abstraction and on no Platform package (I-I13). The
       fifth build check in PackageGraphTests reads this project's references. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
  </ItemGroup>

</Project>
