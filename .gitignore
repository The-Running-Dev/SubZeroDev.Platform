# Dependencies
node_modules/

# Build output
#
# NOT `build/`. That directory holds committed scripts here — the documentation
# gate and the homepage generator, installed by Invoke-SetupDocs and run by
# .github/workflows/docs-ci.yml. Ignoring it made both invisible to git: present
# locally, green locally, absent in CI, with nothing saying why. Name the output
# directories instead, and never re-add a bare `build/`.
dist/
artifacts/
bin/
obj/
*.tsbuildinfo

# Docusaurus local build
.docusaurus/
docs/build/

# graphify — regenerable and expensive; never commit
graphify-out/
.graphify_*

# Env / secrets
.env
.env.*
*.local

# The sample's SQLite file, created on first run
*.db
*.db-shm
*.db-wal

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
