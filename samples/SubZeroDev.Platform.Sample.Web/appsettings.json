{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Platform": {
    "Persistence": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=sample.db"
    },
    "Outbox": {
      "ProcessedRetention": "1.00:00:00",
      "PoisonedRetention": "30.00:00:00"
    }
  }
}
