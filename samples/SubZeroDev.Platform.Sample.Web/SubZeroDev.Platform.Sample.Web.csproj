<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The ordinary build references Platform's projects directly. Passing
       -p:UsePlatformPackages=true (and -p:PlatformPackageVersion=<version>) switches every Platform
       reference to the packages CI packed, so S18.1 reruns the sample and its round-trip assertions
       against the restored packages rather than the source tree, without a second sample to
       maintain. -->
  <ItemGroup Condition="'$(UsePlatformPackages)' != 'true'">
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Hosting\SubZeroDev.Platform.Hosting.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Persistence\SubZeroDev.Platform.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePlatformPackages)' == 'true'">
    <PackageReference Include="SubZeroDev.Platform.Hosting" Version="$(PlatformPackageVersion)" />
    <PackageReference Include="SubZeroDev.Platform.Persistence" Version="$(PlatformPackageVersion)" />
    <PackageReference Include="SubZeroDev.Platform.Identity" Version="$(PlatformPackageVersion)" />
    <PackageReference Include="SubZeroDev.Platform.Audit" Version="$(PlatformPackageVersion)" />
    <PackageReference Include="SubZeroDev.Platform.Organizations" Version="$(PlatformPackageVersion)" />
    <PackageReference Include="SubZeroDev.Platform.Billing" Version="$(PlatformPackageVersion)" />
    <PackageReference Include="SubZeroDev.Platform.Licensing" Version="$(PlatformPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePlatformPackages)' != 'true'">
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Identity\SubZeroDev.Platform.Identity.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Audit\SubZeroDev.Platform.Audit.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Organizations\SubZeroDev.Platform.Organizations.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Billing\SubZeroDev.Platform.Billing.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.Platform.Licensing\SubZeroDev.Platform.Licensing.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
