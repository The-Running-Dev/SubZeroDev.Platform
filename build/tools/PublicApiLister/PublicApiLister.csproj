<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not part of SubZeroDev.Platform.slnx and not under src/, deliberately: this is a build-time
       helper for build/Test-ApiReference.ps1, not a shipped package, and it must not inherit
       src/Directory.Build.props's IsPackable. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referencing all six as ordinary ProjectReferences, rather than loading their built DLLs
         standalone, is what makes reflection over them reliable: it makes MSBuild copy every
         transitive dependency (Serilog, OpenTelemetry, Npgsql, ...) into this console app's own
         output folder, so Assembly.GetTypes() below never hits a missing-assembly error. -->
    <ProjectReference Include="..\..\..\src\SubZeroDev.Platform.Abstractions\SubZeroDev.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\SubZeroDev.Platform.Core\SubZeroDev.Platform.Core.csproj" />
    <ProjectReference Include="..\..\..\src\SubZeroDev.Platform.Hosting\SubZeroDev.Platform.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\SubZeroDev.Platform.Observability\SubZeroDev.Platform.Observability.csproj" />
    <ProjectReference Include="..\..\..\src\SubZeroDev.Platform.Persistence\SubZeroDev.Platform.Persistence.csproj" />
    <ProjectReference Include="..\..\..\src\SubZeroDev.Platform.Testing\SubZeroDev.Platform.Testing.csproj" />
  </ItemGroup>

</Project>
